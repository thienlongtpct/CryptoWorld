# Copy to .env for local server/dev. Secrets stay on the account server — never use VITE_* for these.
# Leave a sponsor key as the example value (or blank) to keep that feature disabled.
# Placeholders (do not commit real values):

# GEMINI_API_KEY="<YOUR_EXISTING_GEMINI_API_KEY>"
# GEMINI_MODEL="<YOUR_ENABLED_GEMINI_MODEL>"
GEMINI_API_KEY=""
GEMINI_MODEL=""

# TINYFISH_API_KEY="<YOUR_TINYFISH_API_KEY>"
# MARITIME_API_KEY="<YOUR_MARITIME_API_KEY>"
TINYFISH_API_KEY="sk-tinyfish-ax6dY9EleIaxUHC9iK_uhIXuujAJifPc"
MARITIME_API_KEY="mk_ij3xDtOAKgHmErrC4qS8WraWgEoo9v6jvDpnKDQ4ZCw"

# TigerData (Tiger Cloud Postgres + TimescaleDB). Set to your service's connection string to
# store accounts, progress and evidence there instead of data/accounts.json. Leave blank to stay on the JSON file.
# TIGER_DATABASE_URL="postgres://tsdbadmin:<PASSWORD>@<SERVICE>.tsdb.cloud.timescale.com:<PORT>/tsdb?sslmode=require"
TIGER_DATABASE_URL=""

# Lab workbench (Forged seal). Leave unset for inline local queue + Maritime when keyed.
# LAB_EXECUTOR=local   # run python3 on this machine instead of Maritime (dev only)
# LAB_QUEUE_URL=       # set by AWS CDK for SQS-backed workers; leave empty locally

# AWS deploy (not needed for local npm run server). Prefer Secrets Manager over baking keys into Lambda env:
# AWS_REGION="<YOUR_AWS_REGION>"
# AWS_PROFILE="<YOUR_AWS_PROFILE>"
# AWS_DEPLOY_ROLE_ARN="<YOUR_EXISTING_AWS_DEPLOY_ROLE_ARN>"
# SPONSOR_SECRET_ARN="<YOUR_SECRET_ARN_IF_USED>"
# Secret JSON shape: { "TINYFISH_API_KEY", "MARITIME_API_KEY", "GEMINI_API_KEY?", "GEMINI_MODEL?", "TIGER_DATABASE_URL?" }
