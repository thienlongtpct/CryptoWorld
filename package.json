{
  "name": "cryptoworld",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --experimental-strip-types server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8765",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\"",
    "ci": "npm run typecheck && npm test && npm run build && node scripts/check-dist.mjs",
    "e2e": "npm run build && playwright test",
    "e2e:live": "playwright test",
    "artifact": "npm run build && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1169.0",
    "@aws-sdk/client-sqs": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "3.1169.0",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.2.1",
    "typescript": "5.6.3",
    "vite": "4.5.5",
    "vite-plugin-singlefile": "0.13.5"
  }
}
